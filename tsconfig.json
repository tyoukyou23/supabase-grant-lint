{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "types": ["node", "vite/client"]
  },
  "include": ["src", "tests", "playground", "tsup.config.ts", "vitest.config.ts"]
}
